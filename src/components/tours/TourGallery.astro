---
/**
 * Galería del tour: foto principal + miniaturas que la cambian.
 * Sin fotos cargadas muestra placeholders con la misma estructura.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Photo {
	src: ImageMetadata;
	alt: string;
}

interface Props {
	lang: Locale;
	photos: Photo[];
	label: string;
	/** Texto del placeholder cuando no hay fotos */
	placeholder?: string;
}

const { lang, photos, label, placeholder = '[Foto]' } = Astro.props;
const t = useTranslations(lang);
const total = photos.length;
---

<section class="gallery" aria-label={label} data-gallery>
	{
		total > 0 ? (
			<>
				<div class="gallery-main">
					{photos.map((photo, i) => (
						<Image
							src={photo.src}
							alt={photo.alt}
							widths={[640, 960, 1280, 1600]}
							sizes="(min-width: 80rem) 860px, (min-width: 64rem) 66vw, 100vw"
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : undefined}
							data-gallery-slide={i}
							hidden={i !== 0}
						/>
					))}
				</div>
				{total > 1 && (
					<ul role="list" class="gallery-thumbs">
						{photos.map((photo, i) => (
							<li>
								<button
									type="button"
									class="thumb"
									aria-pressed={i === 0 ? 'true' : 'false'}
									aria-label={t('gallery.show', { n: i + 1, total })}
									data-gallery-thumb={i}
								>
									<Image src={photo.src} alt="" widths={[160, 240]} sizes="160px" loading="lazy" />
								</button>
							</li>
						))}
					</ul>
				)}
			</>
		) : (
			<>
				<div class="gallery-main media-placeholder" aria-hidden="true">{placeholder}</div>
				<ul role="list" class="gallery-thumbs" aria-hidden="true">
					{[1, 2, 3, 4, 5].map((n) => (
						<li>
							<div class="thumb media-placeholder">{n}</div>
						</li>
					))}
				</ul>
			</>
		)
	}
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const slides = gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]');
		const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				const index = thumb.dataset.galleryThumb;
				slides.forEach((slide) => {
					slide.hidden = slide.dataset.gallerySlide !== index;
				});
				thumbs.forEach((other) => {
					other.setAttribute('aria-pressed', String(other === thumb));
				});
			});
		});
	});
</script>

<style>
	.gallery-main {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.gallery-main :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: gallery-fade var(--duration-menu) var(--ease-out);
	}

	.gallery-main :global(img[hidden]) {
		display: none;
	}

	.gallery-thumbs {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--space-3);
		margin-top: var(--space-3);
	}

	.thumb {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		padding: 0;
		border: 0;
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: transform var(--duration-press) var(--ease-out);
	}

	button.thumb {
		background: none;
		cursor: pointer;
	}

	div.thumb {
		display: flex;
	}

	button.thumb:active {
		transform: scale(0.97);
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb[aria-pressed='true'] {
		outline: 3px solid var(--color-cta);
		outline-offset: 2px;
	}

	@keyframes gallery-fade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
