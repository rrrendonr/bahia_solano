---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	role: string;
	experience?: string;
	bio: string;
	photo?: ImageMetadata;
	photoAlt?: string;
	headingLevel?: 'h3' | 'h4';
}

const { name, role, experience, bio, photo, photoAlt, headingLevel: Heading = 'h3' } = Astro.props;
const meta = [role, experience].filter(Boolean).join(' · ');
---

<article class="team-card">
	<div class="team-photo">
		{
			photo ? (
				<Image src={photo} alt={photoAlt ?? name} widths={[320, 480, 640]} sizes="(min-width: 64rem) 300px, (min-width: 40rem) 45vw, 100vw" />
			) : (
				<div class="media-placeholder" aria-hidden="true">[Foto]</div>
			)
		}
	</div>
	<div class="team-info">
		<Heading class="team-name">{name}</Heading>
		<p class="team-meta">{meta}</p>
		<p class="team-bio">{bio}</p>
	</div>
</article>

<style>
	.team-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.team-photo {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.team-photo :global(img),
	.team-photo .media-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.team-name {
		font-size: var(--text-xl);
		font-weight: var(--weight-black);
	}

	.team-meta {
		margin-top: var(--space-2);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	.team-bio {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}
</style>
