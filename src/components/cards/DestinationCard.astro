---
/**
 * Tarjeta de destino para el listado de Tours y el inicio.
 * `featured`: tarjeta azul a todo el ancho (destino principal).
 * `wide`: tarjeta blanca a todo el ancho con la foto al lado.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
	name: string;
	href: string;
	quoteHref: string;
	eyebrow: string;
	facts: string;
	summary: string;
	viewLabel: string;
	image?: ImageMetadata;
	imageAlt?: string;
	featured?: boolean;
	featuredLabel?: string;
	wide?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const {
	lang,
	name,
	href,
	quoteHref,
	eyebrow,
	facts,
	summary,
	viewLabel,
	image,
	imageAlt = '',
	featured = false,
	featuredLabel,
	wide = false,
	headingLevel: Heading = 'h2',
} = Astro.props;

const t = useTranslations(lang);
---

<article
	class:list={[
		'dest-card',
		{ 'dest-card--featured surface-inverse': featured, 'dest-card--wide': wide && !featured },
	]}
>
	<div class="dest-media">
		{
			image ? (
				<Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes={featured || wide ? '(min-width: 64rem) 60vw, 100vw' : '(min-width: 48rem) 50vw, 100vw'} />
			) : (
				<div class="media-placeholder" aria-hidden="true">[Foto: {name}]</div>
			)
		}
	</div>
	<div class="dest-body">
		{featured && featuredLabel && <span class="dest-badge">{featuredLabel}</span>}
		<p class="eyebrow">{eyebrow}</p>
		<Heading class="dest-title"><a href={href}>{name}</a></Heading>
		<p class="dest-facts">{facts}</p>
		<p class="dest-summary">{summary}</p>
		<div class="dest-actions">
			<Button href={quoteHref} size="sm" class="dest-cta">{t('cta.quoteShort')}</Button>
			<Button href={href} size="sm" variant={featured ? 'ghost' : 'outline'} class="dest-cta">{viewLabel}</Button>
		</div>
	</div>
</article>

<style>
	.dest-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.dest-card--featured,
	.dest-card--wide {
		grid-column: 1 / -1;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.dest-card--featured {
		background: var(--color-inverse-bg);
		border-color: transparent;
	}

	.dest-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.dest-card--featured .dest-media,
	.dest-card--wide .dest-media {
		flex: 999 1 30rem;
		aspect-ratio: auto;
		min-height: 18rem;
	}

	.dest-card--featured .dest-media {
		min-height: 24rem;
	}

	.dest-media :global(img),
	.dest-media .media-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-reveal) var(--ease-out);
	}

	.dest-card--featured .media-placeholder {
		background-color: var(--color-navy-700);
	}

	.dest-body {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		gap: var(--space-3);
		padding: var(--space-7);
	}

	.dest-card--featured .dest-body,
	.dest-card--wide .dest-body {
		flex: 1 1 22rem;
		padding: var(--space-10);
	}

	.dest-badge {
		align-self: flex-start;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		background: var(--color-cta);
		color: var(--color-on-cta);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.dest-title {
		font-size: var(--text-2xl);
	}

	.dest-card--featured .dest-title {
		font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
	}

	/* El título enlaza al destino; su área de clic cubre la tarjeta */
	.dest-title a {
		color: inherit;
		text-decoration: none;
	}

	.dest-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.dest-title a:focus-visible {
		outline: none;
	}

	.dest-card:has(.dest-title a:focus-visible) {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	.dest-facts {
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	.dest-summary {
		color: var(--color-text-muted);
	}

	.dest-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: auto;
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.dest-actions :global(.dest-cta) {
		position: relative;
		z-index: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.dest-card:hover .dest-media :global(img),
		.dest-card:hover .dest-media .media-placeholder {
			transform: scale(1.03);
		}
	}
</style>
