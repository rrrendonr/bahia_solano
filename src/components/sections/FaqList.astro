---
/**
 * Preguntas frecuentes en acordeón nativo (<details>), sin JavaScript.
 * Incluye datos estructurados FAQPage.
 */
interface Props {
	items: { question: string; answer: string }[];
	/** Deja abierta la primera pregunta */
	openFirst?: boolean;
	class?: string;
}

const { items, openFirst = true, class: className } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer },
	})),
};
---

<div class:list={['faq', className]}>
	{
		items.map((item, i) => (
			<details open={openFirst && i === 0}>
				<summary>
					<span>{item.question}</span>
					<svg class="plus" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
						<path d="M12 5v14" />
						<path d="M5 12h14" />
					</svg>
				</summary>
				<p>{item.answer}</p>
			</details>
		))
	}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
	.faq {
		border-top: 3px solid var(--color-navy-900);
	}

	details {
		border-bottom: 1px solid var(--color-border);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		min-height: var(--tap-target);
		padding-block: var(--space-5);
		list-style: none;
		cursor: pointer;
		font-family: var(--font-heading);
		font-weight: var(--weight-bold);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		text-transform: uppercase;
		color: var(--color-heading);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.plus {
		flex-shrink: 0;
		color: var(--color-cta);
		transition: transform var(--duration-menu) var(--ease-out);
	}

	details[open] .plus {
		transform: rotate(45deg);
	}

	details p {
		max-width: 40rem;
		padding-bottom: var(--space-6);
		color: var(--color-text-muted);
	}
</style>
