---
/**
 * Franja de patrocinadores: carrusel continuo de logos en gris (a color al pasar el mouse).
 * - Se pausa al pasar el mouse, al enfocar un logo con teclado y con el botón de pausa (WCAG 2.2.2).
 * - Con "reducir movimiento" activado en el sistema, los logos quedan quietos en una fila.
 * Contenido: src/content/sponsors/*.json
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);

// Velocidad constante: ~4 s por logo
const duration = `${Math.max(sponsors.length * 4, 20)}s`;
---

{
	sponsors.length > 0 && (
		<section class="sponsors" aria-labelledby="sponsors-title" data-sponsors>
			<div class="container sponsors-head">
				<h2 id="sponsors-title" class="eyebrow">
					{t('sponsors.title')}
				</h2>
				<button
					type="button"
					class="sponsors-toggle"
					aria-pressed="false"
					data-sponsors-toggle
					data-label-pause={t('sponsors.pause')}
					data-label-play={t('sponsors.play')}
					aria-label={t('sponsors.pause')}
				>
					<Icon name="pause" size={16} strokeWidth={0} class="icon-pause" />
					<Icon name="play" size={16} strokeWidth={0} class="icon-play" />
				</button>
			</div>

			<div class="marquee" style={`--marquee-duration: ${duration}`}>
				<div class="marquee-track">
					{[0, 1].map((copy) => (
						<ul role="list" class="marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
							{sponsors.map(({ data }) => {
								const logo = data.logo ? (
									<Image src={data.logo} alt={copy === 0 ? data.name : ''} height={48} densities={[1, 2]} class="sponsor-logo" />
								) : (
									<span class="sponsor-placeholder">{data.name}</span>
								);
								return (
									<li class="sponsor">
										{data.url ? (
											<a
												href={data.url}
												target="_blank"
												rel="noopener sponsored"
												tabindex={copy === 1 ? -1 : undefined}
												aria-label={data.logo ? undefined : data.name}
											>
												{logo}
											</a>
										) : (
											logo
										)}
									</li>
								);
							})}
						</ul>
					))}
				</div>
			</div>
		</section>
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-sponsors]').forEach((section) => {
		const toggle = section.querySelector<HTMLButtonElement>('[data-sponsors-toggle]');
		if (!toggle) return;
		toggle.addEventListener('click', () => {
			const paused = toggle.getAttribute('aria-pressed') !== 'true';
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
			section.classList.toggle('is-paused', paused);
		});
	});
</script>

<style>
	.sponsors {
		padding-block: var(--space-16);
		border-top: 1px solid var(--color-border);
	}

	.sponsors-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.sponsors-head h2 {
		font-family: var(--font-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-caps);
		line-height: var(--leading-body);
	}

	.sponsors-toggle {
		display: grid;
		place-items: center;
		width: var(--tap-target);
		height: var(--tap-target);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--color-navy-900);
		cursor: pointer;
		transition: transform var(--duration-press) var(--ease-out);
	}

	.sponsors-toggle:active {
		transform: scale(0.97);
	}

	.sponsors-toggle :global(svg) {
		fill: currentColor;
	}

	.sponsors-toggle :global(.icon-play),
	.sponsors-toggle[aria-pressed='true'] :global(.icon-pause) {
		display: none;
	}

	.sponsors-toggle[aria-pressed='true'] :global(.icon-play) {
		display: block;
	}

	/* --- Carrusel --- */
	.marquee {
		margin-top: var(--space-8);
		overflow: hidden;
		/* Desvanece los bordes */
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee var(--marquee-duration, 30s) linear infinite;
	}

	.sponsors:hover .marquee-track,
	.sponsors:focus-within .marquee-track,
	.sponsors.is-paused .marquee-track {
		animation-play-state: paused;
	}

	.marquee-list {
		display: flex;
		align-items: center;
		gap: var(--space-16);
		padding-right: var(--space-16);
	}

	.sponsor a {
		display: block;
		border-radius: var(--radius-sm);
	}

	.sponsor :global(.sponsor-logo) {
		display: block;
		width: auto;
		height: 3rem;
		max-width: 10rem;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.65;
		transition: opacity var(--duration-hover) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.sponsor:hover :global(.sponsor-logo) {
			filter: none;
			opacity: 1;
		}
	}

	.sponsor a:focus-visible :global(.sponsor-logo) {
		filter: none;
		opacity: 1;
	}

	.sponsor-placeholder {
		display: grid;
		place-items: center;
		height: 3rem;
		padding-inline: var(--space-5);
		border: 1px dashed var(--color-border-strong);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	/* Movimiento reducido: sin desplazamiento, logos quietos y centrados */
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			mask-image: none;
		}
		.marquee-track {
			width: auto;
			animation: none;
			justify-content: center;
		}
		.marquee-list {
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--space-8) var(--space-12);
			padding-right: 0;
		}
		.marquee-list[aria-hidden='true'],
		.sponsors-toggle {
			display: none;
		}
	}
</style>
