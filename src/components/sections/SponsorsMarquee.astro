---
/**
 * Franja de patrocinadores: carrusel continuo de logos a color.
 * - Se pausa al pasar el mouse, al enfocar un logo con teclado y con el botón de pausa (WCAG 2.2.2).
 * - Con "reducir movimiento" activado en el sistema, los logos quedan quietos en una fila.
 * - Sin saltos: el script repite la lista las veces necesarias para cubrir el ancho de la
 *   pantalla y desplaza exactamente el ancho de una lista por vuelta, a velocidad constante.
 * Contenido: src/content/sponsors/*.json
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);

// Velocidad del carrusel en píxeles por segundo
const speed = 40;
---

{
	sponsors.length > 0 && (
		<section class="sponsors" aria-labelledby="sponsors-title" data-sponsors>
			<div class="container sponsors-head">
				<h2 id="sponsors-title" class="eyebrow">
					{t('sponsors.title')}
				</h2>
				<button
					type="button"
					class="sponsors-toggle"
					aria-pressed="false"
					data-sponsors-toggle
					data-label-pause={t('sponsors.pause')}
					data-label-play={t('sponsors.play')}
					aria-label={t('sponsors.pause')}
				>
					<Icon name="pause" size={16} strokeWidth={0} class="icon-pause" />
					<Icon name="play" size={16} strokeWidth={0} class="icon-play" />
				</button>
			</div>

			<div class="marquee" data-marquee data-speed={speed}>
				<div class="marquee-track">
					{[0, 1].map((copy) => (
						<ul role="list" class="marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
							{sponsors.map(({ data }) => {
								const logo = data.logo ? (
									<Image
										src={data.logo}
										alt={copy === 0 ? data.name : ''}
										height={80}
										densities={[1, 2]}
										loading="eager"
										class="sponsor-logo"
									/>
								) : (
									<span class="sponsor-placeholder">{data.name}</span>
								);
								return (
									<li class="sponsor">
										{data.url ? (
											<a
												href={data.url}
												target="_blank"
												rel="noopener sponsored"
												tabindex={copy === 1 ? -1 : undefined}
												aria-label={data.logo ? undefined : data.name}
											>
												{logo}
											</a>
										) : (
											logo
										)}
									</li>
								);
							})}
						</ul>
					))}
				</div>
			</div>
		</section>
	)
}

<script>
	function setupMarquee(marquee: HTMLElement) {
		const track = marquee.querySelector<HTMLElement>('.marquee-track');
		const original = track?.querySelector<HTMLElement>('.marquee-list');
		if (!track || !original) return;
		const speed = Number(marquee.dataset.speed) || 40;

		const layout = () => {
			const listWidth = original.getBoundingClientRect().width;
			if (!listWidth) return;

			// Copias necesarias: cubrir el ancho visible + una lista extra para el reinicio
			const needed = Math.ceil(marquee.clientWidth / listWidth) + 1;
			const lists = track.querySelectorAll('.marquee-list');
			for (let i = lists.length; i < needed; i++) {
				const clone = original.cloneNode(true) as HTMLElement;
				clone.setAttribute('aria-hidden', 'true');
				clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
				clone.querySelectorAll('img').forEach((img) => img.setAttribute('alt', ''));
				track.append(clone);
			}

			// Desplaza exactamente una lista por vuelta, siempre a la misma velocidad
			track.style.setProperty('--marquee-distance', `${listWidth}px`);
			track.style.setProperty('--marquee-duration', `${listWidth / speed}s`);
			marquee.classList.add('is-ready');
		};

		layout();
		new ResizeObserver(layout).observe(original);
		window.addEventListener('resize', layout);
	}

	document.querySelectorAll<HTMLElement>('[data-sponsors]').forEach((section) => {
		const marquee = section.querySelector<HTMLElement>('[data-marquee]');
		if (marquee) setupMarquee(marquee);

		const toggle = section.querySelector<HTMLButtonElement>('[data-sponsors-toggle]');
		if (!toggle) return;
		toggle.addEventListener('click', () => {
			const paused = toggle.getAttribute('aria-pressed') !== 'true';
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
			section.classList.toggle('is-paused', paused);
		});
	});
</script>

<style>
	.sponsors {
		padding-block: var(--space-16);
		border-top: 1px solid var(--color-border);
	}

	.sponsors-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.sponsors-head h2 {
		font-family: var(--font-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-caps);
		line-height: var(--leading-body);
	}

	.sponsors-toggle {
		display: grid;
		place-items: center;
		width: var(--tap-target);
		height: var(--tap-target);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--color-navy-900);
		cursor: pointer;
		transition: transform var(--duration-press) var(--ease-out);
	}

	.sponsors-toggle:active {
		transform: scale(0.97);
	}

	.sponsors-toggle :global(svg) {
		fill: currentColor;
	}

	.sponsors-toggle :global(.icon-play),
	.sponsors-toggle[aria-pressed='true'] :global(.icon-pause) {
		display: none;
	}

	.sponsors-toggle[aria-pressed='true'] :global(.icon-play) {
		display: block;
	}

	/* --- Carrusel --- */
	.marquee {
		margin-top: var(--space-8);
		overflow: hidden;
		/* Desvanece los bordes */
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		/* Sin JavaScript: 2 copias y desplazamiento del 50 % */
		animation: marquee var(--marquee-duration, 40s) linear infinite;
		will-change: transform;
	}

	.sponsors:hover .marquee-track,
	.sponsors:focus-within .marquee-track,
	.sponsors.is-paused .marquee-track {
		animation-play-state: paused;
	}

	.marquee-list {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: var(--space-16);
		padding-right: var(--space-16);
	}

	.sponsor a {
		display: block;
		border-radius: var(--radius-sm);
	}

	/* 80 px de alto; los logos horizontales se limitan a 12 rem de ancho */
	.sponsor :global(.sponsor-logo) {
		display: block;
		width: auto;
		height: 5rem;
		max-width: 12rem;
		object-fit: contain;
		border-radius: var(--radius-md);
		transition: transform var(--duration-hover) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.sponsor a:hover :global(.sponsor-logo) {
			transform: scale(1.04);
		}
	}

	.sponsor-placeholder {
		display: grid;
		place-items: center;
		height: 5rem;
		padding-inline: var(--space-5);
		border: 1px dashed var(--color-border-strong);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(var(--marquee-distance, 50%) * -1));
		}
	}

	/* Movimiento reducido: sin desplazamiento, logos quietos y centrados */
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			mask-image: none;
		}
		.marquee-track {
			width: auto;
			animation: none;
			justify-content: center;
		}
		.marquee-list {
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--space-8) var(--space-12);
			padding-right: 0;
		}
		.marquee-list[aria-hidden='true'],
		.sponsors-toggle {
			display: none;
		}
	}
</style>
