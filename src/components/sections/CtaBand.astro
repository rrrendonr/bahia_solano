---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';
import type { Locale } from '../../i18n/config';
import { localizePath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
	title: string;
	/** Parte del titular resaltada en naranja */
	titleAccent?: string;
	/** Texto después del resaltado; si existe, el resaltado va en la misma línea (p. ej. "¿Cuándo [sales] a pescar?") */
	titleEnd?: string;
	text?: string;
	id?: string;
	/** Botón principal; por defecto "Cotiza tu viaje" → contacto */
	ctaLabel?: string;
	ctaHref?: string;
	/** Texto del botón de WhatsApp; por defecto "WhatsApp" */
	whatsappLabel?: string;
	/**
	 * Mostrar el botón de WhatsApp aunque aún no haya número en site.ts.
	 * Mientras falte el número, el botón lleva a la página de Contacto.
	 */
	alwaysShowWhatsapp?: boolean;
}

const {
	lang,
	title,
	titleAccent,
	titleEnd,
	text,
	id = 'cta',
	ctaLabel,
	ctaHref,
	whatsappLabel = 'WhatsApp',
	alwaysShowWhatsapp = false,
} = Astro.props;
const t = useTranslations(lang);
const { whatsapp } = site.contact;
const headingId = `${id}-title`;
const showWhatsapp = Boolean(whatsapp) || alwaysShowWhatsapp;
// Con número: abre WhatsApp en otra pestaña. Sin número: enlace provisional a Contacto.
const whatsappLink = whatsapp
	? { href: `https://wa.me/${whatsapp}`, target: '_blank', rel: 'noopener' }
	: { href: localizePath('contact', lang) };
---

<section id={id} class="cta-band surface-inverse" aria-labelledby={headingId}>
	<div class="container cta-inner">
		<div class="cta-copy">
			<h2 id={headingId}>
				{title}{titleAccent && ' '}
				{titleAccent && <span class:list={['accent', { 'accent--inline': titleEnd }]}>{titleAccent}</span>}{titleEnd && ` ${titleEnd}`}
			</h2>
			{text && <p class="cta-text">{text}</p>}
		</div>
		<div class="cta-actions">
			<Button href={ctaHref ?? localizePath('contact', lang)}>{ctaLabel ?? t('cta.quote')}</Button>
			{
				showWhatsapp && (
					<Button variant="ghost" {...whatsappLink}>
						<Icon name="message" size={22} strokeWidth={2} />
						{whatsappLabel}
					</Button>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta-band {
		padding-block: var(--section-space);
	}

	.cta-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-10);
	}

	.cta-copy {
		max-width: 47.5rem;
	}

	.cta-copy h2 {
		font-size: clamp(3rem, 1.8rem + 4.5vw, 6rem);
	}

	.accent {
		display: block;
		color: var(--color-cta);
	}

	.accent--inline {
		display: inline;
		/* Palabra corta resaltada: no se corta con guion */
		white-space: nowrap;
		hyphens: manual;
	}

	.cta-text {
		max-width: 32.5rem;
		margin-top: var(--space-6);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
</style>
