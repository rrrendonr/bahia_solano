---
/**
 * Imagen con "dirección de arte": una foto para celular y otra para pantallas grandes.
 * El navegador descarga solo la que corresponde a su ancho, en AVIF o WebP
 * (con JPG de respaldo) y en el tamaño justo para la pantalla.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	desktop: ImageMetadata;
	mobile: ImageMetadata;
	alt: string;
	/** Ancho desde el que se usa la foto de escritorio */
	breakpoint?: string;
	desktopWidths?: number[];
	mobileWidths?: number[];
	/** Carga prioritaria (para la imagen principal, visible al cargar la página) */
	priority?: boolean;
	class?: string;
}

const {
	desktop,
	mobile,
	alt,
	breakpoint = '48rem',
	desktopWidths = [960, 1280, 1920, 2560],
	mobileWidths = [480, 640, 960, 1280],
	priority = false,
	class: className,
} = Astro.props;

const formats = ['avif', 'webp'] as const;
const mobileQuery = `(max-width: calc(${breakpoint} - 0.01px))`;

const build = (src: ImageMetadata, widths: number[]) =>
	Promise.all(
		formats.map(async (format) => ({
			type: `image/${format}`,
			srcset: (await getImage({ src, widths, format })).srcSet.attribute,
		})),
	);

const [mobileSources, desktopSources, fallback] = await Promise.all([
	build(mobile, mobileWidths),
	build(desktop, desktopWidths),
	getImage({ src: desktop, widths: desktopWidths, format: 'jpg' }),
]);
---

<picture class={className}>
	{
		mobileSources.map((source) => (
			<source
				media={mobileQuery}
				type={source.type}
				srcset={source.srcset}
				sizes="100vw"
				width={mobile.width}
				height={mobile.height}
			/>
		))
	}
	{desktopSources.map((source) => <source type={source.type} srcset={source.srcset} sizes="100vw" />)}
	<img
		src={fallback.src}
		srcset={fallback.srcSet.attribute}
		sizes="100vw"
		alt={alt}
		width={desktop.width}
		height={desktop.height}
		loading={priority ? 'eager' : 'lazy'}
		fetchpriority={priority ? 'high' : 'auto'}
		decoding={priority ? 'sync' : 'async'}
	/>
</picture>
