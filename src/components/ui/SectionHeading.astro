---
interface Props {
	eyebrow?: string;
	title: string;
	intro?: string;
	as?: 'h1' | 'h2';
	id?: string;
	class?: string;
}

const { eyebrow, title, intro, as: Tag = 'h2', id, class: className } = Astro.props;
---

<div class:list={['section-heading', className]}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<Tag id={id}>{title}</Tag>
	{intro && <p class="intro">{intro}</p>}
</div>

<style>
	.section-heading {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: 40rem;
	}

	.section-heading :is(h1, h2) {
		color: var(--color-heading);
	}

	.intro {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
	}
</style>
