---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Crumb {
	label: string;
	/** Sin href = página actual */
	href?: string;
}

interface Props {
	lang: Locale;
	items: Crumb[];
	class?: string;
}

const { lang, items, class: className } = Astro.props;
const t = useTranslations(lang);
const siteUrl = Astro.site ?? Astro.url;

// Datos estructurados BreadcrumbList para Google
const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		item: new URL(item.href ?? Astro.url.pathname, siteUrl).href,
	})),
};
---

<nav class:list={['breadcrumbs', className]} aria-label={t('breadcrumb.label')}>
	<ol role="list">
		{
			items.map((item) => (
				<li>
					{item.href ? (
						<>
							<a href={item.href}>{item.label}</a>
							<span class="sep" aria-hidden="true">/</span>
						</>
					) : (
						<span aria-current="page">{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
	ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	li {
		display: flex;
		gap: var(--space-2);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	[aria-current='page'] {
		font-weight: var(--weight-semibold);
		color: var(--color-heading);
	}

	@media (hover: hover) and (pointer: fine) {
		a:hover {
			color: var(--color-heading);
			text-decoration: underline;
		}
	}
</style>
