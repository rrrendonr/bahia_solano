---
import Icon from '../ui/Icon.astro';
import { localeMeta, locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
	alternates: Record<Locale, string>;
	class?: string;
}

const { lang, alternates, class: className } = Astro.props;
const t = useTranslations(lang);
---

<nav class:list={['lang-switcher', className]} aria-label={t('lang.label')}>
	<Icon name="globe" size={18} class="lang-icon" />
	<ul role="list">
		{
			locales.map((l) => (
				<li>
					<a
						href={alternates[l]}
						hreflang={localeMeta[l].hreflang}
						lang={localeMeta[l].hreflang}
						aria-current={l === lang ? 'true' : undefined}
						aria-label={localeMeta[l].label}
					>
						{localeMeta[l].short}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.lang-switcher {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.lang-switcher :global(.lang-icon) {
		margin-inline: var(--space-3) var(--space-1);
		color: var(--color-navy-900);
	}

	ul {
		display: flex;
		margin: 0;
	}

	a {
		display: grid;
		place-items: center;
		min-width: var(--tap-target);
		min-height: var(--tap-target);
		font-family: var(--font-heading);
		font-weight: var(--weight-bold);
		font-size: var(--text-base);
		letter-spacing: var(--tracking-button);
		color: var(--color-navy-900);
		text-decoration: none;
		transition:
			background-color var(--duration-hover) var(--ease-out),
			color var(--duration-hover) var(--ease-out);
	}

	a[aria-current='true'] {
		background: var(--color-navy-900);
		color: var(--color-sand-50);
	}

	a:focus-visible {
		outline-offset: -3px;
	}

	@media (hover: hover) and (pointer: fine) {
		a:not([aria-current='true']):hover {
			background: var(--color-teal-50);
		}
	}
</style>
