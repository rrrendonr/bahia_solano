---
/**
 * Sección del hotel (Darien Lodge): descripción, datos clave y galería por categorías.
 * El contenido vive en src/content/lodge/darien-lodge.json.
 */
import { getEntry } from 'astro:content';
import LodgeGallery from './LodgeGallery.astro';
import type { Locale } from '../../i18n/config';

interface Props {
	lang: Locale;
	id?: string;
}

const { lang, id = 'hotel' } = Astro.props;

const entry = await getEntry('lodge', 'darien-lodge');
if (!entry) throw new Error('Falta src/content/lodge/darien-lodge.json');
const lodge = entry.data;
const headingId = `${id}-title`;
---

<section id={id} class="lodge section" aria-labelledby={headingId}>
	<div class="container">
		<div class="lodge-head">
			<div class="lodge-copy">
				<p class="eyebrow">{lodge.eyebrow[lang]}</p>
				<h2 id={headingId}>{lodge.name}</h2>
				<p class="lodge-description">{lodge.description[lang]}</p>
			</div>
			{
				lodge.facts.length > 0 && (
					<dl class="lodge-facts">
						{lodge.facts.map((fact) => (
							<div>
								<dt>{fact.label[lang]}</dt>
								<dd>{fact.value[lang]}</dd>
							</div>
						))}
					</dl>
				)
			}
		</div>

		<div class="lodge-gallery-wrap">
			<LodgeGallery
				lang={lang}
				idPrefix={id}
				categories={lodge.categories.map((c) => ({ id: c.id, label: c.label[lang] }))}
				photos={lodge.photos.map((p) => ({ category: p.category, caption: p.caption[lang], src: p.src }))}
			/>
		</div>
	</div>
</section>

<style>
	.lodge {
		background: var(--color-surface-muted);
		--color-accent: var(--color-teal-800);
	}

	.lodge-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-8) var(--space-16);
	}

	.lodge-copy {
		flex: 999 1 32rem;
		min-width: 0;
	}

	.lodge-copy h2 {
		margin-top: var(--space-4);
	}

	.lodge-description {
		max-width: 37.5rem;
		margin-top: var(--space-6);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.lodge-facts {
		flex: 1 1 20rem;
		max-width: 26rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 3px solid var(--color-navy-900);
	}

	.lodge-facts div {
		padding: var(--space-4) var(--space-4) var(--space-4) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.lodge-facts dt {
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.lodge-facts dd {
		margin: var(--space-1) 0 0;
		font-family: var(--font-heading);
		font-weight: var(--weight-bold);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.lodge-gallery-wrap {
		margin-top: var(--space-12);
	}
</style>
