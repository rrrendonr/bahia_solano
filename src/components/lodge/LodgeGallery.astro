---
/**
 * Galería por categorías (pestañas) con foto ampliada en un <dialog> nativo.
 * - Pestañas accesibles: flechas izquierda/derecha, Inicio y Fin.
 * - Lightbox: flechas para navegar, Esc o clic en el fondo para cerrar.
 * Las fotos sin `src` se muestran como placeholder con su pie de foto.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
	categories: { id: string; label: string }[];
	photos: { category: string; caption: string; src?: ImageMetadata }[];
	/** Prefijo único para los ids (si hay más de una galería en la página) */
	idPrefix?: string;
}

const { lang, categories, photos, idPrefix = 'gallery' } = Astro.props;
const t = useTranslations(lang);

// Versión grande de cada foto para el lightbox
const panels = await Promise.all(
	categories.map(async (category) => ({
		...category,
		photos: await Promise.all(
			photos
				.filter((photo) => photo.category === category.id)
				.map(async (photo) => ({
					...photo,
					full: photo.src ? (await getImage({ src: photo.src, width: 1600 })).src : undefined,
				})),
		),
	})),
);
---

<div class="lodge-gallery" data-lodge-gallery>
	<div role="tablist" aria-label={t('gallery.categories')} class="tabs">
		{
			panels.map((panel, i) => (
				<button
					type="button"
					role="tab"
					id={`${idPrefix}-tab-${panel.id}`}
					aria-controls={`${idPrefix}-panel-${panel.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-tab
				>
					{panel.label}
				</button>
			))
		}
	</div>

	{
		panels.map((panel, i) => (
			<div
				role="tabpanel"
				id={`${idPrefix}-panel-${panel.id}`}
				aria-labelledby={`${idPrefix}-tab-${panel.id}`}
				hidden={i !== 0}
				data-panel
			>
				<ul role="list" class="grid">
					{panel.photos.map((photo) => (
						<li>
							<button
								type="button"
								class="cell"
								data-photo
								data-full={photo.full}
								data-caption={photo.caption}
								aria-label={t('gallery.enlarge', { caption: photo.caption })}
							>
								{photo.src ? (
									<Image
										src={photo.src}
										alt=""
										widths={[400, 640, 800]}
										sizes="(min-width: 64rem) 25vw, 50vw"
										loading="lazy"
									/>
								) : (
									<span class="media-placeholder">{photo.caption}</span>
								)}
							</button>
						</li>
					))}
				</ul>
			</div>
		))
	}

	<p class="hint">{t('gallery.hint')}</p>

	<dialog class="lightbox" aria-label={t('lightbox.label')} data-lightbox>
		<button type="button" class="lb-close" aria-label={t('lightbox.close')} data-lb-close>
			<Icon name="x" size={22} strokeWidth={2} />
		</button>
		<div class="lb-body">
			<button type="button" class="lb-nav" aria-label={t('lightbox.prev')} data-lb-prev>
				<Icon name="chevron-left" size={24} strokeWidth={2.25} />
			</button>
			<div class="lb-stage">
				<img alt="" hidden data-lb-img />
				<div class="media-placeholder lb-placeholder" data-lb-placeholder></div>
			</div>
			<button type="button" class="lb-nav" aria-label={t('lightbox.next')} data-lb-next>
				<Icon name="chevron-right" size={24} strokeWidth={2.25} />
			</button>
		</div>
		<p class="lb-caption" aria-live="polite" data-lb-caption></p>
	</dialog>
</div>

<script>
	function setupGallery(root: HTMLElement) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

		// --- Pestañas ---
		const selectTab = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				const selected = i === index;
				tab.setAttribute('aria-selected', String(selected));
				tab.tabIndex = selected ? 0 : -1;
				panels[i].hidden = !selected;
			});
			if (focus) tabs[index].focus();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => selectTab(i));
			tab.addEventListener('keydown', (event) => {
				const last = tabs.length - 1;
				const moves: Record<string, number> = {
					ArrowRight: i === last ? 0 : i + 1,
					ArrowLeft: i === 0 ? last : i - 1,
					Home: 0,
					End: last,
				};
				if (event.key in moves) {
					event.preventDefault();
					selectTab(moves[event.key], true);
				}
			});
		});

		// --- Lightbox ---
		const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
		const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
		const placeholder = root.querySelector<HTMLElement>('[data-lb-placeholder]');
		const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
		if (!dialog || !img || !placeholder || !caption) return;

		let items: HTMLButtonElement[] = [];
		let current = 0;
		let trigger: HTMLButtonElement | null = null;

		const show = (index: number) => {
			current = (index + items.length) % items.length;
			const item = items[current];
			const text = item.dataset.caption ?? '';
			const full = item.dataset.full;

			if (full) {
				img.src = full;
				img.alt = text;
				img.hidden = false;
				placeholder.hidden = true;
			} else {
				img.hidden = true;
				placeholder.hidden = false;
				placeholder.textContent = text;
			}
			caption.textContent = `${text} · ${current + 1} / ${items.length}`;
		};

		root.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((button) => {
			button.addEventListener('click', () => {
				const panel = button.closest<HTMLElement>('[data-panel]');
				items = Array.from(panel?.querySelectorAll<HTMLButtonElement>('[data-photo]') ?? []);
				trigger = button;
				show(items.indexOf(button));
				dialog.showModal();
			});
		});

		root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
		root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
		root.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});

		// Clic en el fondo oscuro cierra
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		// Devuelve el foco a la foto que abrió el lightbox
		dialog.addEventListener('close', () => trigger?.focus());
	}

	document.querySelectorAll<HTMLElement>('[data-lodge-gallery]').forEach(setupGallery);
</script>

<style>
	/* --- Pestañas --- */
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	[role='tab'] {
		min-height: var(--tap-target);
		padding-inline: var(--space-5);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--color-navy-900);
		font-family: var(--font-heading);
		font-weight: var(--weight-bold);
		font-size: 1.125rem;
		letter-spacing: var(--tracking-button);
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background-color var(--duration-hover) var(--ease-out),
			color var(--duration-hover) var(--ease-out),
			transform var(--duration-press) var(--ease-out);
	}

	[role='tab']:active {
		transform: scale(0.97);
	}

	[role='tab'][aria-selected='true'] {
		background: var(--color-navy-900);
		border-color: var(--color-navy-900);
		color: var(--color-sand-50);
	}

	@media (hover: hover) and (pointer: fine) {
		[role='tab'][aria-selected='false']:hover {
			background: rgb(0 43 91 / 0.06);
		}
	}

	/* --- Mosaico --- */
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: clamp(8rem, 22vw, 12.5rem);
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.grid li:first-child {
		grid-column: span 2;
		grid-row: span 2;
	}

	/* Móvil (2 columnas): si la última foto queda sola, ocupa la fila completa */
	.grid li:nth-child(2n):last-child {
		grid-column: span 2;
	}

	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		/* Escritorio (4 columnas, la primera foto ocupa 2×2): la última fila siempre se completa */
		.grid li:nth-child(2n):last-child {
			grid-column: auto;
		}
		.grid li:nth-child(4n + 2):last-child {
			grid-column: span 4;
		}
		.grid li:nth-child(4n + 2):nth-last-child(2),
		.grid li:nth-child(4n + 3):last-child {
			grid-column: span 2;
		}
		.grid li:nth-child(4n + 4):last-child {
			grid-column: span 2;
		}
	}

	.cell {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: none;
		cursor: zoom-in;
	}

	.cell :global(img),
	.cell .media-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-reveal) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.cell:hover :global(img),
		.cell:hover .media-placeholder {
			transform: scale(1.03);
		}
	}

	.hint {
		margin-top: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	/* --- Lightbox --- */
	.lightbox {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: var(--space-6);
		border: 0;
		background: transparent;
		color: var(--color-sand-50);
	}

	.lightbox[open] {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-5);
		animation: lb-in var(--duration-menu) var(--ease-out);
	}

	.lightbox::backdrop {
		background: rgb(0 26 56 / 0.96);
	}

	.lb-close {
		position: absolute;
		top: var(--space-5);
		right: var(--space-5);
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1px solid rgb(250 249 246 / 0.4);
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--color-sand-50);
		cursor: pointer;
	}

	.lb-body {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		width: 100%;
		max-width: 70rem;
	}

	.lb-stage {
		flex: 1;
		min-width: 0;
		aspect-ratio: 3 / 2;
		max-height: 80vh;
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.lb-stage img,
	.lb-placeholder {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.lb-stage img[hidden],
	.lb-placeholder[hidden] {
		display: none;
	}

	.lb-nav {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border: 0;
		border-radius: var(--radius-full);
		background: var(--color-cta);
		color: var(--color-on-cta);
		cursor: pointer;
		transition: transform var(--duration-press) var(--ease-out);
	}

	.lb-nav:active,
	.lb-close:active {
		transform: scale(0.97);
	}

	.lb-caption {
		color: rgb(250 249 246 / 0.85);
		text-align: center;
	}

	.lightbox :focus-visible {
		outline-color: var(--color-teal-500);
	}

	@media (max-width: 40rem) {
		.lb-body {
			flex-wrap: wrap;
			justify-content: center;
		}
		.lb-stage {
			flex-basis: 100%;
			order: -1;
		}
	}

	@keyframes lb-in {
		from {
			opacity: 0;
			transform: scale(0.98);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
