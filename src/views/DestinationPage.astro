---
/**
 * Plantilla única para todos los destinos (Bahía Solano, Chile, Orinoco, Costa Rica).
 * Contenido: src/content/destinations/<slug>.json + textos en src/content/tours-page/{es,en}.json
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import TourGallery from '../components/tours/TourGallery.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { localeMeta, locales, type Locale } from '../i18n/config';
import { getAlternates, localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import {
	destinationEyebrow,
	destinationPath,
	destinationQuotePath,
	fill,
	getDestinations,
	pending,
	type Destination,
} from '../lib/destinations';
import { site } from '../config/site';

interface Props {
	lang: Locale;
	destination: Destination;
}

const { lang, destination } = Astro.props;
const t = useTranslations(lang);
const d = destination.data;

const entry = await getEntry('toursPage', lang);
if (!entry) throw new Error(`Falta src/content/tours-page/${lang}.json`);
const dc = entry.data.detail;

const others = (await getDestinations()).filter((o) => o.id !== destination.id);

// El slug es igual en ambos idiomas
const alternates = getAlternates('tours', Object.fromEntries(locales.map((l) => [l, destination.id])));
const siteUrl = Astro.site ?? Astro.url;
const quoteHref = destinationQuotePath(lang, destination.id);
const { whatsapp } = site.contact;
const eyebrow = destinationEyebrow(d, lang);

const photos = [
	...(d.cover ? [{ src: d.cover, alt: d.coverAlt?.[lang] ?? d.name }] : []),
	...d.gallery.map((p) => ({ src: p.src, alt: p.alt[lang] })),
];

const headlineFacts = [
	fill(dc.days, { n: pending(d.duration.days) }),
	d.mainSpecies?.[lang],
	d.fishingType?.[lang],
]
	.filter(Boolean)
	.join(' · ');

const summary = [
	{
		label: dc.summary.duration,
		value: fill(dc.summary.durationValue, { days: pending(d.duration.days), nights: pending(d.duration.nights) }),
	},
	{ label: dc.summary.fishingDays, value: pending(d.duration.fishingDays) },
	{ label: dc.summary.species, value: pending(d.species?.[lang], '—') },
	{ label: dc.summary.season, value: pending(d.season?.[lang], '—') },
	{ label: dc.summary.departure, value: pending(d.departure?.[lang], '—') },
	{ label: dc.summary.lodging, value: pending(d.lodging, '—') },
];

const pageUrl = new URL(alternates[lang], siteUrl).href;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'TouristTrip',
	name: d.name,
	description: d.summary[lang],
	url: pageUrl,
	inLanguage: localeMeta[lang].htmlLang,
	touristType: 'Sport fishing',
	itinerary: {
		'@type': 'ItemList',
		itemListElement: d.itinerary.map((step, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: `${step.day[lang]}: ${step.title[lang]}`,
			description: step.text[lang],
		})),
	},
	provider: { '@type': 'TravelAgency', name: site.name, url: new URL(`/${lang}/`, siteUrl).href },
	...(d.cover ? { image: new URL(d.cover.src, siteUrl).href } : {}),
};
---

<BaseLayout
	lang={lang}
	title={d.name}
	description={d.summary[lang]}
	alternates={alternates}
	current="tours"
	image={d.cover?.src}
	imageAlt={d.coverAlt?.[lang]}
	schema={schema}
>
	<!-- Migas + título -->
	<section class="detail-head">
		<div class="container">
			<Breadcrumbs
				lang={lang}
				items={[
					{ label: t('nav.home'), href: localizePath('home', lang) },
					{ label: t('nav.tours'), href: localizePath('tours', lang) },
					{ label: d.name },
				]}
			/>
			<div class="detail-title">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{d.name}</h1>
				<p class="detail-facts">{headlineFacts}</p>
			</div>
		</div>
	</section>

	<!-- Galería + resumen -->
	<section class="detail-top">
		<div class="container detail-top-inner">
			<TourGallery lang={lang} photos={photos} label={dc.galleryLabel} placeholder={`[${dc.galleryLabel}]`} />

			<aside class="summary surface-inverse" aria-labelledby="summary-title">
				<p id="summary-title" class="eyebrow">{dc.summaryTitle}</p>
				<dl>
					{
						summary.map((item) => (
							<div>
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))
					}
				</dl>
				<div class="summary-actions">
					<Button href={quoteHref}>{dc.quote}</Button>
					{
						whatsapp && (
							<Button href={`https://wa.me/${whatsapp}`} variant="ghost" target="_blank" rel="noopener">
								<Icon name="message" size={22} strokeWidth={2} />
								{t('cta.askWhatsapp')}
							</Button>
						)
					}
				</div>
			</aside>
		</div>
	</section>

	<!-- El destino -->
	<section class="section" aria-labelledby="about-title">
		<div class="container split">
			<div class="split-heading">
				<p class="eyebrow">{dc.aboutEyebrow}</p>
				<h2 id="about-title">{d.headline[lang]}</h2>
			</div>
			<div class="about-text">
				{d.paragraphs.map((p) => <p>{p[lang]}</p>)}
			</div>
		</div>
	</section>

	<!-- Itinerario -->
	{
		d.itinerary.length > 0 && (
			<section class="section itinerary" aria-labelledby="itin-title">
				<div class="container">
					<p class="eyebrow">{dc.itineraryEyebrow}</p>
					<h2 id="itin-title" class="itinerary-title">{dc.itineraryTitle}</h2>
					<ol role="list" class="itinerary-list">
						{d.itinerary.map((step) => (
							<li>
								<span class="itinerary-day">{step.day[lang]}</span>
								<h3>{step.title[lang]}</h3>
								<p>{step.text[lang]}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<!-- Incluye / no incluye -->
	{
		(d.included.length > 0 || d.excluded.length > 0) && (
			<section class="section" aria-labelledby="inc-title">
				<div class="container">
					<h2 id="inc-title">{dc.includesTitle}</h2>
					<div class="includes-grid">
						{d.included.length > 0 && (
							<div class="includes-box surface-inverse">
								<h3>{dc.includedTitle}</h3>
								<ul role="list">
									{d.included.map((item) => (
										<li>
											<Icon name="check" size={22} strokeWidth={2.25} class="inc-icon" />
											{item[lang]}
										</li>
									))}
								</ul>
							</div>
						)}
						{d.excluded.length > 0 && (
							<div class="includes-box includes-box--outline">
								<h3>{dc.excludedTitle}</h3>
								<ul role="list">
									{d.excluded.map((item) => (
										<li>
											<svg class="inc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
											{item[lang]}
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</div>
			</section>
		)
	}

	<!-- Otros destinos -->
	{
		others.length > 0 && (
			<section class="section section--flush-top" aria-labelledby="other-title">
				<div class="container">
					<h2 id="other-title" class="other-title">{dc.otherTitle}</h2>
					<ul role="list" class="other-grid">
						{others.map((o) => (
							<li>
								<a class="other-card" href={destinationPath(lang, o.id)}>
									<div class="other-media">
										{o.data.cover ? (
											<Image src={o.data.cover} alt="" widths={[240, 360]} sizes="140px" />
										) : (
											<div class="media-placeholder" aria-hidden="true">[Foto]</div>
										)}
									</div>
									<div>
										<h3>{o.data.name}</h3>
										<p>
											{o.data.country[lang]} · {fill(dc.days, { n: pending(o.data.duration.days) })}
										</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<CtaBand
		lang={lang}
		title={fill(dc.ctaTitle, { name: d.name })}
		titleAccent={dc.ctaTitleAccent}
		text={dc.ctaText}
		ctaLabel={dc.quote}
		ctaHref={quoteHref}
	/>
</BaseLayout>

<style>
	/* --- Encabezado --- */
	.detail-head {
		padding-top: var(--space-8);
	}

	.detail-title {
		margin-top: var(--space-12);
	}

	.detail-title h1 {
		margin-top: var(--space-4);
		font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
	}

	.detail-facts {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	/* --- Galería + resumen --- */
	.detail-top {
		padding-top: var(--space-12);
	}

	.detail-top-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-8);
	}

	.detail-top-inner > :global(.gallery) {
		flex: 999 1 40rem;
		min-width: 0;
	}

	.summary {
		flex: 1 1 20rem;
		padding: var(--space-8);
		border-radius: var(--radius-lg);
	}

	.summary dl {
		margin-top: var(--space-5);
	}

	.summary dl div {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	.summary dd {
		margin: 0;
		font-weight: var(--weight-semibold);
		text-align: right;
	}

	.summary-actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-7);
	}

	/* --- El destino --- */
	.split {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-16);
	}

	.split-heading {
		flex: 1 1 22rem;
		max-width: 30rem;
	}

	.split-heading h2 {
		margin-top: var(--space-4);
	}

	.about-text {
		flex: 999 1 35rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	/* --- Itinerario --- */
	.itinerary {
		background: var(--color-surface-muted);
		--color-accent: var(--color-teal-800);
	}

	.itinerary-title {
		margin-top: var(--space-4);
	}

	.itinerary-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		margin-top: var(--space-12);
		border-top: 3px solid var(--color-navy-900);
	}

	.itinerary-list li {
		padding: var(--space-7) var(--space-7) var(--space-8) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.itinerary-day {
		font-family: var(--font-heading);
		font-weight: var(--weight-black);
		font-size: var(--text-lg);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.itinerary-list h3 {
		margin-top: var(--space-3);
	}

	.itinerary-list p {
		margin-top: var(--space-3);
		color: var(--color-text-muted);
	}

	/* --- Incluye --- */
	.includes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-7);
		margin-top: var(--space-12);
	}

	.includes-box {
		padding: var(--space-10);
		border-radius: var(--radius-lg);
	}

	.includes-box--outline {
		border: 1px solid var(--color-border-strong);
		color: var(--color-text-muted);
	}

	.includes-box h3 {
		font-size: var(--text-2xl);
		color: var(--color-heading);
	}

	.includes-box ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.includes-box li {
		display: flex;
		gap: var(--space-3);
	}

	.includes-box :global(.inc-icon) {
		flex-shrink: 0;
		margin-top: 3px;
	}

	.surface-inverse :global(.inc-icon) {
		color: var(--color-inverse-accent);
	}

	/* --- Otros destinos --- */
	.section--flush-top {
		padding-top: 0;
	}

	.other-title {
		font-size: var(--text-2xl);
	}

	.other-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
		gap: var(--space-7);
		margin-top: var(--space-10);
	}

	.other-card {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		height: 100%;
		padding-right: var(--space-6);
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		color: inherit;
		text-decoration: none;
	}

	.other-media {
		flex-shrink: 0;
		align-self: stretch;
		width: 8.75rem;
		min-height: 7.5rem;
	}

	.other-media :global(img),
	.other-media .media-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.other-card h3 {
		font-size: var(--text-xl);
	}

	.other-card p {
		margin-top: var(--space-2);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	@media (hover: hover) and (pointer: fine) {
		.other-card:hover h3 {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}
</style>
