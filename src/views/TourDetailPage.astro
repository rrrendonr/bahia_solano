---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TourGallery from '../components/tours/TourGallery.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { localeMeta, locales, type Locale } from '../i18n/config';
import { getAlternates, localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { fill, getTours, pending, tourPath, tourQuotePath, type Tour } from '../lib/tours';
import { site } from '../config/site';

interface Props {
	lang: Locale;
	tour: Tour;
}

const { lang, tour } = Astro.props;
const t = useTranslations(lang);
const d = tour.data;

const entry = await getEntry('toursPage', lang);
if (!entry) throw new Error(`Falta src/content/tours-page/${lang}.json`);
const c = entry.data;
const dc = c.detail;

const otherTours = (await getTours()).filter((other) => other.id !== tour.id);

// El slug del tour es igual en ambos idiomas
const alternates = getAlternates('tours', Object.fromEntries(locales.map((l) => [l, tour.id])));
const siteUrl = Astro.site ?? Astro.url;
const quoteHref = tourQuotePath(lang, tour.id);
const { whatsapp } = site.contact;

// Galería: portada + fotos adicionales
const photos = [
	...(d.cover ? [{ src: d.cover, alt: d.coverAlt?.[lang] ?? d.name }] : []),
	...d.gallery.map((p) => ({ src: p.src, alt: p.alt[lang] })),
];

const specs = [
	`${pending(d.lengthFt)} ${t('tour.feet')}`,
	t('tour.anglers', { n: pending(d.maxAnglers) }),
	t('tour.crew'),
].join(' · ');

const summary = [
	{
		label: dc.summary.duration,
		value: fill(dc.summary.durationValue, {
			days: pending(d.duration.days),
			nights: pending(d.duration.nights),
		}),
	},
	{ label: dc.summary.fishingDays, value: pending(d.duration.fishingDays) },
	{ label: dc.summary.anglers, value: fill(dc.summary.anglersValue, { n: pending(d.maxAnglers) }) },
	{ label: dc.summary.departure, value: dc.summary.departureValue },
	{ label: dc.summary.lodging, value: 'Darien Lodge' },
];

const techSpecs = [
	{ label: dc.specs.length, value: `${pending(d.lengthFt)} ${t('tour.feet')}` },
	{ label: dc.specs.engine, value: pending(d.specs.engine, '[Motor]') },
	{ label: dc.specs.capacity, value: fill(dc.summary.anglersValue, { n: pending(d.maxAnglers) }) },
	{ label: dc.specs.crew, value: pending(d.specs.crew?.[lang], '—') },
	{ label: dc.specs.fishingType, value: pending(d.specs.fishingType?.[lang], '—') },
	{ label: dc.specs.onboard, value: pending(d.specs.onboard?.[lang], '—') },
];

const pageUrl = new URL(alternates[lang], siteUrl).href;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'TouristTrip',
	name: d.name,
	description: d.summary[lang],
	url: pageUrl,
	inLanguage: localeMeta[lang].htmlLang,
	touristType: 'Sport fishing',
	itinerary: {
		'@type': 'ItemList',
		itemListElement: d.itinerary.map((step, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: `${step.day[lang]}: ${step.title[lang]}`,
			description: step.text[lang],
		})),
	},
	provider: {
		'@type': 'TravelAgency',
		name: site.name,
		url: new URL(`/${lang}/`, siteUrl).href,
	},
	...(d.cover ? { image: new URL(d.cover.src, siteUrl).href } : {}),
};
---

<BaseLayout
	lang={lang}
	title={d.name}
	description={d.summary[lang]}
	alternates={alternates}
	current="tours"
	image={d.cover?.src}
	imageAlt={d.coverAlt?.[lang]}
	schema={schema}
>
	<!-- Migas + título -->
	<section class="detail-head">
		<div class="container">
			<Breadcrumbs
				lang={lang}
				items={[
					{ label: t('nav.home'), href: localizePath('home', lang) },
					{ label: t('nav.tours'), href: localizePath('tours', lang) },
					{ label: d.name },
				]}
			/>
			<div class="detail-title">
				{d.featured && <span class="badge">{c.featuredLabel}</span>}
				{!d.featured && d.category && <span class="badge badge--muted">{d.category[lang]}</span>}
				<h1>{d.name}</h1>
				<p class="detail-specs">{specs}</p>
			</div>
		</div>
	</section>

	<!-- Galería + resumen -->
	<section class="detail-top">
		<div class="container detail-top-inner">
			<TourGallery lang={lang} photos={photos} label={dc.galleryLabel} placeholder={`[${dc.galleryLabel}]`} />

			<aside class="summary surface-inverse" aria-labelledby="summary-title">
				<p id="summary-title" class="eyebrow">{dc.summaryTitle}</p>
				<dl>
					{
						summary.map((item) => (
							<div>
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))
					}
				</dl>
				<div class="summary-actions">
					<Button href={quoteHref}>{t('cta.quoteTour')}</Button>
					{
						whatsapp && (
							<Button href={`https://wa.me/${whatsapp}`} variant="ghost" target="_blank" rel="noopener">
								<Icon name="message" size={22} strokeWidth={2} />
								{t('cta.askWhatsapp')}
							</Button>
						)
					}
				</div>
			</aside>
		</div>
	</section>

	<!-- El bote + ficha técnica -->
	<section class="section" aria-labelledby="boat-title">
		<div class="container split">
			<SectionHeading id="boat-title" eyebrow={dc.boatEyebrow} title={d.headline[lang]} intro={d.description[lang]} />
			<dl class="tech-specs">
				{
					techSpecs.map((spec) => (
						<div>
							<dt>{spec.label}</dt>
							<dd>{spec.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- Itinerario -->
	{
		d.itinerary.length > 0 && (
			<section class="section itinerary" aria-labelledby="itin-title">
				<div class="container">
					<SectionHeading id="itin-title" eyebrow={dc.itineraryEyebrow} title={dc.itineraryTitle} />
					<ol role="list" class="itinerary-list">
						{d.itinerary.map((step) => (
							<li>
								<span class="itinerary-day">{step.day[lang]}</span>
								<h3>{step.title[lang]}</h3>
								<p>{step.text[lang]}</p>
							</li>
						))}
					</ol>
					<p class="included-note">
						{dc.includedNote}{' '}
						<a href={`${localizePath('tours', lang)}#inc-title`}>{dc.includedLink} →</a>
					</p>
				</div>
			</section>
		)
	}

	<!-- Otros tours -->
	{
		otherTours.length > 0 && (
			<section class="section" aria-labelledby="other-title">
				<div class="container">
					<h2 id="other-title" class="other-title">{dc.otherToursTitle}</h2>
					<ul role="list" class="other-grid">
						{otherTours.map((other) => (
							<li>
								<a class="other-card" href={tourPath(lang, other.id)}>
									<div class="other-media">
										{other.data.cover ? (
											<Image src={other.data.cover} alt="" widths={[240, 360]} sizes="180px" />
										) : (
											<div class="media-placeholder" aria-hidden="true">[Foto]</div>
										)}
									</div>
									<div>
										<h3>{other.data.name}</h3>
										<p>
											{pending(other.data.lengthFt)} {t('tour.feet')} · {t('tour.anglers', { n: pending(other.data.maxAnglers) })}
										</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<CtaBand
		lang={lang}
		title={dc.cta.title}
		titleAccent={dc.cta.titleAccent}
		text={dc.cta.text}
		ctaLabel={t('cta.quoteTour')}
		ctaHref={quoteHref}
	/>
</BaseLayout>

<style>
	/* --- Encabezado --- */
	.detail-head {
		padding-top: var(--space-8);
	}

	.detail-title {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		margin-top: var(--space-12);
	}

	.detail-title h1 {
		font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
	}

	.badge {
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		background: var(--color-cta);
		color: var(--color-on-cta);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.badge--muted {
		background: var(--color-teal-50);
		color: var(--color-teal-800);
	}

	.detail-specs {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	/* --- Galería + resumen --- */
	.detail-top {
		padding-top: var(--space-12);
	}

	.detail-top-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-8);
	}

	.detail-top-inner > :global(.gallery) {
		flex: 999 1 40rem;
		min-width: 0;
	}

	.summary {
		flex: 1 1 20rem;
		padding: var(--space-8);
		border-radius: var(--radius-lg);
	}

	.summary dl {
		margin-top: var(--space-5);
	}

	.summary dl div {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	.summary dd {
		margin: 0;
		font-weight: var(--weight-semibold);
		text-align: right;
	}

	.summary-actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-7);
	}

	/* --- Ficha técnica --- */
	.split {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-16);
	}

	.split > :global(.section-heading) {
		flex: 1 1 22rem;
		max-width: 30rem;
	}

	.tech-specs {
		flex: 999 1 35rem;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
		border-top: 3px solid var(--color-navy-900);
	}

	.tech-specs div {
		padding: var(--space-6) var(--space-6) var(--space-6) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.tech-specs dt {
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.tech-specs dd {
		margin: var(--space-2) 0 0;
		font-family: var(--font-heading);
		font-weight: var(--weight-bold);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		text-transform: uppercase;
	}

	/* --- Itinerario --- */
	.itinerary {
		background: var(--color-surface-muted);
		--color-accent: var(--color-teal-800);
	}

	.itinerary-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		margin-top: var(--space-12);
		border-top: 3px solid var(--color-navy-900);
	}

	.itinerary-list li {
		padding: var(--space-7) var(--space-7) var(--space-8) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.itinerary-day {
		font-family: var(--font-heading);
		font-weight: var(--weight-black);
		font-size: var(--text-lg);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.itinerary-list h3 {
		margin-top: var(--space-3);
	}

	.itinerary-list p {
		margin-top: var(--space-3);
		color: var(--color-text-muted);
	}

	.included-note {
		margin-top: var(--space-8);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.included-note a {
		font-weight: var(--weight-bold);
	}

	/* --- Otros tours --- */
	.other-title {
		font-size: var(--text-2xl);
	}

	.other-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-7);
		margin-top: var(--space-10);
	}

	.other-card {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		padding-right: var(--space-6);
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		color: inherit;
		text-decoration: none;
	}

	.other-media {
		flex-shrink: 0;
		align-self: stretch;
		width: 11.25rem;
		min-height: 8.75rem;
	}

	.other-media :global(img),
	.other-media .media-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.other-card h3 {
		font-size: var(--text-xl);
	}

	.other-card p {
		margin-top: var(--space-2);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
	}

	@media (hover: hover) and (pointer: fine) {
		.other-card:hover h3 {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}
</style>
