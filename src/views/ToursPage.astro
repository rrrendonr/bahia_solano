---
/**
 * Listado de Tours: destinos, comparativa, preguntas frecuentes generales y cierre.
 * Contenido: src/content/tours-page/{es,en}.json y src/content/destinations/*.json
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import DestinationCard from '../components/cards/DestinationCard.astro';
import FaqList from '../components/sections/FaqList.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { localeMeta, type Locale } from '../i18n/config';
import { getAlternates } from '../i18n/routes';
import {
	destinationEyebrow,
	destinationFacts,
	destinationPath,
	destinationQuotePath,
	fill,
	getDestinations,
	pending,
	type Destination,
} from '../lib/destinations';
import { site } from '../config/site';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;

const entry = await getEntry('toursPage', lang);
if (!entry) throw new Error(`Falta src/content/tours-page/${lang}.json`);
const c = entry.data;

const destinations = await getDestinations();
const alternates = getAlternates('tours');
const siteUrl = Astro.site ?? Astro.url;

// Disposición del listado: destacados a todo el ancho; si los demás quedan impares, el último también
const regular = destinations.filter((d) => !d.data.featured);
const isWide = (d: Destination) => regular.length % 2 === 1 && d === regular.at(-1);

type Data = Destination['data'];
const rows: { label: string; value: (d: Data) => string }[] = [
	{ label: c.comparison.rows.country, value: (d) => d.country[lang] },
	{ label: c.comparison.rows.fishingType, value: (d) => pending(d.fishingType?.[lang], '—') },
	{ label: c.comparison.rows.species, value: (d) => pending(d.species?.[lang], '—') },
	{ label: c.comparison.rows.duration, value: (d) => fill(c.detail.days, { n: pending(d.duration.days) }) },
	{ label: c.comparison.rows.season, value: (d) => pending(d.season?.[lang], '—') },
	{ label: c.comparison.rows.departure, value: (d) => pending(d.departure?.[lang], '—') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: c.seo.title,
	inLanguage: localeMeta[lang].htmlLang,
	itemListElement: destinations.map((d, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: new URL(destinationPath(lang, d.id), siteUrl).href,
		name: d.data.name,
	})),
	provider: { '@type': 'TravelAgency', name: site.name },
};
---

<BaseLayout
	lang={lang}
	title={c.seo.title}
	description={c.seo.description}
	alternates={alternates}
	current="tours"
	schema={schema}
>
	<!-- Encabezado -->
	<section class="page-hero" aria-labelledby="tours-title">
		<div class="container page-hero-inner">
			<div class="page-hero-heading">
				<p class="eyebrow">{c.hero.eyebrow}</p>
				<h1 id="tours-title">{c.hero.title} <span class="accent">{c.hero.titleAccent}</span></h1>
			</div>
			<p class="page-hero-intro">{c.hero.intro}</p>
		</div>
	</section>

	<!-- Destinos -->
	<section class="destinations-list">
		<div class="container destinations-grid">
			{
				destinations.map((d) => (
					<DestinationCard
						lang={lang}
						name={d.data.name}
						href={destinationPath(lang, d.id)}
						quoteHref={destinationQuotePath(lang, d.id)}
						eyebrow={destinationEyebrow(d.data, lang)}
						facts={destinationFacts(d.data, lang, c.detail.days)}
						summary={d.data.summary[lang]}
						viewLabel={c.viewDestination}
						image={d.data.cover}
						imageAlt={d.data.coverAlt?.[lang]}
						featured={d.data.featured}
						featuredLabel={c.featuredLabel}
						wide={isWide(d)}
					/>
				))
			}
		</div>
	</section>

	<!-- Comparativa -->
	<section class="section comparison" aria-labelledby="cmp-title">
		<div class="container">
			<SectionHeading id="cmp-title" eyebrow={c.comparison.eyebrow} title={c.comparison.title} />
			<div class="table-scroll" role="region" aria-labelledby="cmp-title" tabindex="0">
				<table>
					<caption class="sr-only">{c.comparison.caption}</caption>
					<thead>
						<tr>
							<td></td>
							{
								destinations.map((d) => (
									<th scope="col">
										<a href={destinationPath(lang, d.id)}>{d.data.name}</a>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody>
						{
							rows.map((row) => (
								<tr>
									<th scope="row">{row.label}</th>
									{destinations.map((d) => (
										<td>{row.value(d.data)}</td>
									))}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- Preguntas frecuentes generales -->
	<section class="section" aria-labelledby="faq-title">
		<div class="container split">
			<SectionHeading id="faq-title" eyebrow={c.faq.eyebrow} title={c.faq.title} intro={c.faq.intro} />
			<FaqList items={c.faq.items} class="faq-list" />
		</div>
	</section>

	<CtaBand lang={lang} title={c.cta.title} titleAccent={c.cta.titleAccent} text={c.cta.text} />
</BaseLayout>

<style>
	.page-hero {
		padding-block: var(--space-24) var(--space-16);
	}

	.page-hero-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-10);
	}

	.page-hero-heading {
		flex: 999 1 35rem;
		min-width: 0;
	}

	.page-hero-heading h1 {
		margin-top: var(--space-5);
		font-size: clamp(3.5rem, 2rem + 5.5vw, 7rem);
	}

	.accent {
		color: var(--color-cta);
	}

	.page-hero-intro {
		flex: 1 1 20rem;
		max-width: 26rem;
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.destinations-list {
		padding-bottom: var(--section-space);
	}

	.destinations-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-7);
	}

	@media (min-width: 48rem) {
		.destinations-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* --- Comparativa --- */
	.comparison {
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}

	.table-scroll {
		margin-top: var(--space-12);
		overflow-x: auto;
	}

	table {
		width: 100%;
		min-width: 53.75rem;
		border-collapse: collapse;
	}

	th,
	td {
		padding: var(--space-4) var(--space-5);
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--color-border);
	}

	thead th,
	thead td {
		border-bottom: 3px solid var(--color-navy-900);
	}

	thead th {
		font-family: var(--font-heading);
		font-weight: var(--weight-black);
		font-size: var(--text-xl);
		text-transform: uppercase;
		line-height: var(--leading-snug);
	}

	thead th a {
		color: var(--color-heading);
		text-decoration: none;
	}

	thead th a:hover {
		text-decoration: underline;
	}

	tbody th {
		width: 20%;
		font-weight: var(--weight-semibold);
	}

	tbody td {
		color: var(--color-text-muted);
	}

	/* --- FAQ --- */
	.split {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-16);
	}

	.split > :global(.section-heading) {
		flex: 1 1 20rem;
		max-width: 25rem;
	}

	.split > :global(.faq-list) {
		flex: 999 1 35rem;
		min-width: 0;
	}
</style>
