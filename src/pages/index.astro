---
/**
 * La raíz redirige al idioma por defecto.
 * En hosting estático se genera una redirección con meta refresh;
 * al desplegar conviene configurar además un 301 de "/" a "/es/" en el hosting.
 */
import { defaultLocale } from '../i18n/config';

const target = `/${defaultLocale}/`;
const canonical = new URL(target, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href={canonical} />
		<title>Bahía Solano Pesca</title>
	</head>
	<body>
		<a href={target}>Bahía Solano Pesca</a>
	</body>
</html>
