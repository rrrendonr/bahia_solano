---
/**
 * Página DEMO del sistema de diseño. Muestra los componentes con contenido provisional.
 * Se reemplazará por la página de Inicio definitiva en el siguiente paso.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import heroImage from '../../assets/images/hero.jpg';
import heroMobileImage from '../../assets/images/hero-mobile.jpg';
import ArtDirectedImage from '../../components/ui/ArtDirectedImage.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import SponsorsMarquee from '../../components/sections/SponsorsMarquee.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StepCard from '../../components/cards/StepCard.astro';
import DestinationCard from '../../components/cards/DestinationCard.astro';
import { getEntry } from 'astro:content';
import {
	destinationEyebrow,
	destinationFacts,
	destinationPath,
	destinationQuotePath,
	getDestinations,
} from '../../lib/destinations';
import TestimonialCard from '../../components/cards/TestimonialCard.astro';
import { getLangStaticPaths, isLocale, localeMeta } from '../../i18n/config';
import { getAlternates, localizePath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../config/site';

export const getStaticPaths = getLangStaticPaths;

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Idioma no soportado: ${lang}`);

const t = useTranslations(lang);
const alternates = getAlternates('home');

const content = {
	es: {
		title: 'Paquetes de pesca deportiva en Colombia y Latinoamérica',
		description:
			'Paquetes de pesca deportiva en destinos salvajes de Colombia y Latinoamérica: vuelos, hospedaje y bote con tripulación, guía y equipo.',
		heroEyebrow: 'Pesca deportiva · Colombia y más allá',
		heroTitle: 'Pesca donde',
		heroTitleAccent: 'el mar manda',
		heroText:
			'Paquetes de pesca deportiva en destinos salvajes de Colombia y Latinoamérica. Vuelos, hospedaje y bote con tripulación, guía y equipo. Tú solo llegas a pescar.',
		heroSecondary: 'Ver destinos',
		heroAlt: 'Pesca deportiva a bordo de un bote en el mar Pacífico',
		stepsEyebrow: 'El paquete',
		stepsTitle: 'De tu ciudad a la línea de pesca, sin vueltas',
		stepsIntro:
			'Armamos el viaje completo para que no tengas que coordinar aerolínea, hotel y lancha por separado. Esto es lo que va en cada paquete.',
		steps: [
			{ icon: 'plane', title: 'Vuelos incluidos', text: 'Ida y regreso al destino. Coordinamos los vuelos para que llegues listo a pescar.' },
			{ icon: 'house', title: 'Hospedaje', text: 'El lodge u hotel elegido para cada viaje, cerca del agua. Descansas bien y sales temprano a pescar.' },
			{ icon: 'sailboat', title: 'Bote con tripulación', text: 'Sales con capitán, tripulación y un guía que conoce la zona.' },
			{ icon: 'fish', title: 'Equipo de pesca', text: 'Cañas, carretes y señuelos listos. No tienes que viajar cargado.' },
		],
		toursEyebrow: 'Destinos',
		toursTitle: 'A dónde vamos a pescar',
		testimonialsEyebrow: 'Quienes ya fueron',
		ctaTitle: '¿Cuándo',
		ctaTitleAccent: 'sales',
		ctaTitleEnd: 'a pescar?',
		ctaText: 'Cuéntanos a dónde quieres ir, fechas y cuántos viajan. Te respondemos con disponibilidad y el precio del paquete.',
	},
	en: {
		title: 'Sport fishing packages in Colombia and Latin America',
		description:
			'Sport fishing packages to wild destinations in Colombia and Latin America: flights, lodging and a boat with crew, guide and tackle.',
		heroEyebrow: 'Sport fishing · Colombia and beyond',
		heroTitle: 'Fish where',
		heroTitleAccent: 'the sea rules',
		heroText:
			'Sport fishing packages to wild destinations in Colombia and Latin America. Flights, lodging and a boat with crew, guide and tackle. You just show up and fish.',
		heroSecondary: 'See destinations',
		heroAlt: 'Sport fishing on board a boat in the Pacific Ocean',
		stepsEyebrow: 'The package',
		stepsTitle: 'From your city to the fishing line, hassle-free',
		stepsIntro:
			'We put the whole trip together, so you don’t have to book flights, lodging and boat separately. Here’s what every package includes.',
		steps: [
			{ icon: 'plane', title: 'Flights included', text: 'Round trip to the destination. We coordinate your flights so you arrive ready to fish.' },
			{ icon: 'house', title: 'Lodging', text: 'The lodge or hotel chosen for each trip, close to the water. Rest well and head out early.' },
			{ icon: 'sailboat', title: 'Boat with crew', text: 'You head out with a captain, crew and a guide who knows the area.' },
			{ icon: 'fish', title: 'Fishing tackle', text: 'Rods, reels and lures ready to go. No need to travel loaded.' },
		],
		toursEyebrow: 'Destinations',
		toursTitle: 'Where we fish',
		testimonialsEyebrow: 'From our guests',
		ctaTitle: 'When do you',
		ctaTitleAccent: 'head out',
		ctaTitleEnd: 'to fish?',
		ctaText: 'Tell us where you want to go, your dates and how many are traveling. We’ll reply with availability and the package price.',
	},
} as const;

const c = content[lang];

// Destinos (los mismos del listado de Tours)
const destinations = await getDestinations();
const toursText = (await getEntry('toursPage', lang))?.data;
const regularDestinations = destinations.filter((d) => !d.data.featured);

// Imagen para redes sociales (1200×630) generada a partir de la foto del hero
const ogImage = await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const schema = {
	'@context': 'https://schema.org',
	'@type': 'TravelAgency',
	name: site.name,
	url: new URL(alternates[lang], Astro.site).href,
	inLanguage: localeMeta[lang].htmlLang,
	address: {
		'@type': 'PostalAddress',
		addressLocality: site.locality,
		addressRegion: site.region,
		addressCountry: site.country,
	},
	areaServed: site.locality,
	// Perfiles oficiales: ayudan a Google a asociar las redes con la marca
	sameAs: Object.values(site.social).filter(Boolean),
};
---

<BaseLayout
	lang={lang}
	title={c.title}
	description={c.description}
	alternates={alternates}
	current="home"
	schema={schema}
	image={ogImage.src}
	imageAlt={c.heroAlt}
>
	<!-- Hero -->
	<section class="hero surface-inverse" aria-labelledby="hero-title">
		<div class="hero-media">
			<ArtDirectedImage
				desktop={heroImage}
				mobile={heroMobileImage}
				alt={c.heroAlt}
				priority
				class="hero-img"
			/>
			<div class="hero-scrim" aria-hidden="true"></div>
		</div>
		<div class="container hero-content">
			<p class="eyebrow">{c.heroEyebrow}</p>
			<h1 id="hero-title">{c.heroTitle} <span class="accent">{c.heroTitleAccent}</span></h1>
			<p class="hero-text">{c.heroText}</p>
			<div class="hero-actions">
				<Button href={localizePath('contact', lang)}>{t('cta.quote')}</Button>
				<Button href="#destinos" variant="ghost">{c.heroSecondary}</Button>
			</div>
		</div>
	</section>

	<!-- Pasos (StepCard) -->
	<section class="section" aria-labelledby="steps-title">
		<div class="container split">
			<SectionHeading id="steps-title" eyebrow={c.stepsEyebrow} title={c.stepsTitle} intro={c.stepsIntro} />
			<ol role="list" class="steps-grid">
				{
					c.steps.map((step, i) => (
						<StepCard number={String(i + 1).padStart(2, '0')} icon={step.icon} title={step.title} text={step.text} />
					))
				}
			</ol>
		</div>
	</section>

	<!-- Destinos -->
	<section id="destinos" class="section section--flush-top" aria-labelledby="tours-title">
		<div class="container">
			<SectionHeading id="tours-title" eyebrow={c.toursEyebrow} title={c.toursTitle} />
			<div class="tours-grid">
				{
					toursText &&
						destinations.map((d) => (
							<DestinationCard
								lang={lang}
								name={d.data.name}
								href={destinationPath(lang, d.id)}
								quoteHref={destinationQuotePath(lang, d.id)}
								eyebrow={destinationEyebrow(d.data, lang)}
								facts={destinationFacts(d.data, lang, toursText.detail.days)}
								summary={d.data.summary[lang]}
								viewLabel={toursText.viewDestination}
								image={d.data.cover}
								imageAlt={d.data.coverAlt?.[lang]}
								featured={d.data.featured}
								featuredLabel={toursText.featuredLabel}
								wide={regularDestinations.length % 2 === 1 && d === regularDestinations.at(-1)}
								headingLevel="h3"
							/>
						))
				}
			</div>
		</div>
	</section>

	<!-- Testimonios (TestimonialCard) -->
	<section class="section testimonials" aria-labelledby="testimonials-title">
		<div class="container">
			<h2 id="testimonials-title" class="eyebrow">{c.testimonialsEyebrow}</h2>
			<div class="testimonials-grid">
				<TestimonialCard variant="featured" quote="[Testimonio destacado]" name="[Nombre]" origin="[Ciudad, país]" />
				<TestimonialCard quote="[Segundo testimonio]" name="[Nombre]" origin="[Ciudad, país]" />
			</div>
		</div>
	</section>

	<!-- ¿Cuándo sales a pescar? -->
	<CtaBand
		lang={lang}
		id="contacto"
		title={c.ctaTitle}
		titleAccent={c.ctaTitleAccent}
		titleEnd={c.ctaTitleEnd}
		text={c.ctaText}
		whatsappLabel={t('cta.whatsapp')}
		alwaysShowWhatsapp
	/>

	<!-- Patrocinadores -->
	<SponsorsMarquee lang={lang} />
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: min(47.5rem, 92svh);
		overflow: hidden;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		background-color: var(--color-navy-900);
	}

	.hero-media :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Escritorio: mantiene el bote a la vista cuando la foto se recorta */
		object-position: 62% 60%;
	}

	/* Celular: foto vertical, encuadre en el pescador y la caña */
	@media (max-width: 47.99rem) {
		.hero-media :global(img) {
			object-position: 40% 55%;
		}
	}

	/* Degradado azul para que el texto blanco se lea sobre el cielo claro */
	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(0 26 56 / 0.92) 0%, rgb(0 26 56 / 0.7) 40%, rgb(0 26 56 / 0.5) 75%, rgb(0 26 56 / 0.45) 100%),
			linear-gradient(to right, rgb(0 26 56 / 0.6) 0%, rgb(0 26 56 / 0) 70%);
	}

	.hero-content {
		position: relative;
		padding-block: var(--space-30) var(--space-16);
	}

	.hero h1 {
		max-width: 15ch;
		margin-top: var(--space-5);
	}

	.hero .accent {
		color: var(--color-cta);
	}

	.hero-text {
		max-width: 35rem;
		margin-top: var(--space-7);
		font-size: var(--text-lg);
		color: var(--color-inverse-text-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-8);
	}

	.split {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-16);
	}

	.split > :global(.section-heading) {
		flex: 1 1 20rem;
		max-width: 26rem;
	}

	.steps-grid {
		flex: 999 1 35rem;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		border-top: 3px solid var(--color-navy-900);
	}

	.section--flush-top {
		padding-top: 0;
	}

	@media (min-width: 48rem) {
		.tours-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.tours-grid {
		display: grid;
		gap: var(--space-7);
		margin-top: var(--space-12);
	}

	.testimonials {
		background: var(--color-surface-muted);
	}

	.testimonials .eyebrow {
		color: var(--color-teal-800);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.75rem), 1fr));
		gap: var(--space-12);
		margin-top: var(--space-6);
	}

	@media (min-width: 64rem) {
		.testimonials-grid {
			grid-template-columns: 2fr 1fr;
		}
	}
</style>
